#include "../include/head.hh"
<script src="/jppp/jppp.js" defer></script>
<body>
		#include "../include/header.hh"

		MARK_ACTIVE("jppp")

		<link rel="stylesheet" href="/index.css">

		<article id="jppp">
			<h1>Jazz Piano Practice Planner</h1>	
			<div class="art_content">
			<h2>My last completed session was on...</h2>
			<p id="lastTime">dd-mm-yyyy hh-mm-sss</p>
			<h2>I have to practice...</h2>
			<p>the chords...</p>
			
			<ol>
				<li id='c1'>Chord 1</li>
				<li id='c2'>Chord 2</li>
			</ol>
			
			<p>and the types...</p>
			
			<ol id="types_list">
			</ol>
			
			<h2>I have practiced...</h2>
			
			<div id="butts">
				<input type="checkbox" id="a" name="ca" value="yes">
				<label for="a">Root Inv.</label><br>
				<input type="checkbox" id="b" name="cb" value="yes">
				<label for="b">1st Inv.</label><br>			      
				<input type="checkbox" id="c" name="cc" value="yes">
				<label for="c">2nd Inv.</label><br>			      
				<input type="checkbox" id="d" name="cd" value="yes">
				<label for="d">3rd Inv.<label><br>			      
			</div>
			      
			</div>

	</div>

	</div>


</body>
